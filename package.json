{
  "name": "solid-principles-guide",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-build.mjs && node scripts/verify-branding.mjs && node scripts/verify-java-files.mjs && node scripts/verify-principle-code.mjs && node scripts/verify-stories.mjs && node scripts/verify-coherence.mjs",
    "test:site": "npm run build && npm run verify",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:live": "SITE_URL=https://jaswanth-batturi.github.io/solid-principles-guide node scripts/e2e.mjs",
    "test:e2e:full": "node scripts/e2e-full.mjs",
    "test:e2e:deep": "node scripts/e2e-deep.mjs",
    "test:e2e:full:live": "SITE_URL=https://jaswanth-batturi.github.io/solid-principles-guide node scripts/e2e-full.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
