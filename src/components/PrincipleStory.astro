---
import { getIllustration } from '../data/principles/principle-illustrations';

interface Props {
  slug: string;
  icon: string;
  example: string;
  overview: string;
  steps: [string, string, string];
}

const { slug, icon, example, overview, steps } = Astro.props;
const illo = getIllustration(slug, icon);
const stepLabels: [string, string, string] = [
  '1. Everyday situation',
  '2. What goes wrong without the principle',
  '3. How the principle fixes it',
];
---

<section class="rounded-xl border border-violet-500/20 bg-slate-900/40 overflow-hidden shadow-lg shadow-indigo-950/40" aria-label="Real-life analogy">
  <div class="border-b border-slate-800 bg-gradient-to-r from-indigo-950/80 via-violet-950/50 to-cyan-950/40 px-5 py-4 sm:px-6">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-lg font-semibold text-white">Real-life analogy</h2>
      <span class="rounded-full bg-indigo-500/25 px-3 py-1 text-xs font-medium text-indigo-100 border border-indigo-400/30">
        {example}
      </span>
    </div>
    <p class="mt-3 text-base sm:text-lg leading-relaxed text-slate-300">{overview}</p>
  </div>

  <div class="border-b border-slate-800 bg-gradient-to-br from-indigo-600/15 via-violet-600/10 to-cyan-500/10 px-6 py-10 sm:py-12">
    <div class="mx-auto max-w-2xl w-full [&_svg]:w-full [&_svg]:h-auto [&_svg]:min-h-[160px] [&_svg]:max-h-[280px]" set:html={illo.svg} />
    <p class="mt-5 text-center text-base font-medium text-indigo-200/90">{illo.label}</p>
  </div>

  <div class="px-5 py-6 sm:px-6">
    <ol class="space-y-4 list-none">
      {steps.map((step, i) => (
        <li class="rounded-xl border border-slate-700/80 bg-slate-950/50 p-5">
          <span class="text-xs font-bold uppercase tracking-wide text-violet-300">{stepLabels[i]}</span>
          <p class="mt-3 text-base leading-relaxed text-slate-300">{step}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
