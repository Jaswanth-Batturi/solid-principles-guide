---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../utils/paths';
---

<BaseLayout title="Page not found" description="The page you requested does not exist.">
  <section class="text-center py-16">
    <p class="text-6xl font-bold text-indigo-500">404</p>
    <h1 class="mt-4 text-2xl font-bold text-white">Page not found</h1>
    <p class="mt-3 text-slate-400">That URL does not exist. Try the principle library or principle finder instead.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={sitePath()} class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 transition-colors">
        Back to home
      </a>
      <a href={sitePath('#principles')} class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-indigo-500 hover:text-white transition-colors">
        Browse principles
      </a>
      <a href={sitePath('#finder')} class="rounded-xl border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 hover:border-indigo-500 hover:text-white transition-colors">
        Principle finder
      </a>
    </div>
  </section>
</BaseLayout>
