---
import '../styles/global.css';
import { sitePath } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
}

const siteTitle = 'SOLID Principles';
const siteTagline = 'Real examples and runnable Java for all five SOLID principles.';
const { title, description = siteTagline } = Astro.props;
const home = sitePath();
const principlesAnchor = sitePath('#principles');
const finderAnchor = sitePath('#finder');
const ogImage = new URL(sitePath('og-image.jpg'), Astro.site).href;
const pageTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6" aria-label="Main">
        <a href={home} class="group flex items-center gap-2.5 font-semibold text-white" aria-label="SOLID Principles home">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-xs font-bold tracking-tight" aria-hidden="true">SP</span>
          <span class="sm:hidden group-hover:text-indigo-300 transition-colors">SOLID</span>
          <span class="hidden sm:inline group-hover:text-indigo-300 transition-colors">{siteTitle}</span>
        </a>
        <div class="flex items-center gap-5 text-sm">
          <a href={principlesAnchor} class="text-slate-400 hover:text-white transition-colors">Principles</a>
          <a href={finderAnchor} class="text-slate-400 hover:text-white transition-colors">Finder</a>
          <a
            href="https://github.com/Jaswanth-Batturi/solid-principles-guide"
            class="text-slate-400 hover:text-white transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        </div>
      </nav>
    </header>
    <main id="main-content" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>
    <footer class="border-t border-slate-800 py-6 text-center text-sm text-slate-500">
      <p class="text-slate-400">{siteTitle}</p>
      <p class="mt-1 text-xs text-slate-500">{siteTagline}</p>
      <p class="mt-3 text-xs">
        <a href="https://github.com/Jaswanth-Batturi/design-patterns-guide" class="text-slate-500 hover:text-indigo-300" target="_blank" rel="noopener noreferrer">Also see: 23 GoF patterns →</a>
        <span class="mx-2 text-slate-700">·</span>
        <a href="https://github.com/Jaswanth-Batturi" class="text-indigo-400 hover:text-indigo-300" target="_blank" rel="noopener noreferrer">Jaswanth Batturi</a>
      </p>
    </footer>
  </body>
</html>
